# Copy to backend/.env and fill in what you have. Everything is optional —
# the app gracefully degrades to demo data when secrets are missing.

# Claude / Anthropic — enables AI receipt parsing & financial advisor
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Direct IMAP fallback for mail ingestion (e.g. Gmail app password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# MCP HTTP bridges. Point these at any MCP server exposed over HTTP that
# implements POST /list -> {"items": [...]}. Examples include the Gmail MCP
# server, WhatsApp MCP, iMessage MCP, etc.
MCP_MAIL_URL=
MCP_MESSAGES_URL=

DEFAULT_CURRENCY=USD
